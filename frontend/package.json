{
  "name": "kizunapdf-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/pdf-assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/pdf-assets.mjs && tsc -b && vite build",
    "check": "tsc -b",
    "format": "prettier --write src scripts vite.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.394",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
